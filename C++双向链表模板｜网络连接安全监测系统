## ⚙️ 核心原理
1. **双向链表**
每个节点包含`prev`前驱指针、`next`后继指针。删除节点不需要从头遍历，直接操作前后指针，维护链表完整性，防止断链、悬空指针。
```cpp
// 删除节点核心指针操作
P->prev->next = P->next;
P->next->prev = P->prev;
delete P;
```
2. **C++泛型模板编程**
`template<class T>`实现通用双向链表，既可以存基础内置类型，也可以存储自定义`NetNode`结构体，代码复用性强。

## 📝 完整源码
```cpp
#include<iostream>
using namespace std;

template<class T>
class doub_Link {
public :
    class node {
    public :
        T data;
        node* prev;
        node* next;
        node () :prev(NULL), next(NULL) {}
        node(T dt , node* p, node* n) :data(dt), prev(p), next(n) {}
    };
    int size;
    node* head;
    node* tail;

    doub_Link () :size (0) , head(NULL), tail(NULL) {}

    //尾部插入
    void link_push_up (T dt) {
        if (size < 0) {
            cout << "FALSE1" ;
            return ;
        }
        if (size == 0) {
            node* p = new node(dt , NULL , NULL);
            head = p;
            tail = p;
            ++size;
        }
        else{
            node* p = new node(dt , tail , NULL);
            tail->next = p;
            tail = p;
            ++size;
        }
    }

    //头删
    void link_pop_up () {
        if (size <= 0) { cout << "FALSE2" ; return ; }
        if (size == 1) {
            delete head;
            head = NULL;
            --size;
        }
        else {
            node* p = head->next;
            delete head;
            head = p;
            p->prev = NULL;
            --size;
        }
    }

    //尾删
    void link_pop_end () {
        if (size <= 0) { cout << "FALSE3" ; return ; }
        if (size == 1){
            delete head;
            head = NULL;
            tail = NULL;
            --size;
        }
        else {
            node* p = tail->prev;
            delete tail;
            tail = p;
            p->next = NULL;
            --size;
        }
    }

    //在last节点之后插入
    void link_insert_down (T d, node* last) {
        if (last == NULL || last == tail) {
            link_push_up (d);
        }
        else{
            node* p = new node(d, last , last->next);
            node* a = last->next;
            a->prev = p;
            last->next = p;
            ++size;
        }
    }

    //按照索引i定位节点
    node* destination (int i) {
        if ((i>=0) && (i<= size-1)) {
            node* now = head;
            while (i--) {
                now = now->next;
            }
            return now;
        }
        else{
            cout << "FALSE5" ;
            return NULL;
        }
    }

    //删除指定节点
    void link_delete (node* p) {
        if (p == NULL) { cout << "FALSE6" ; return ; }
        if (p == head) {
            link_pop_up ();
        }
        else if (p == tail) {
            link_pop_end ();
        }
        else {
            p->prev->next = p->next;
            p->next->prev = p->prev;
            delete p;
            --size;
        }
    }

    //清空整个链表，释放全部内存
    void clear () {
        while (head != NULL) {
            node* n = head->next;
            delete head;
            head = n;
        }
        head = tail = NULL;
        size = 0;
    }

    //遍历打印
    void print () const{
        node* cur = head;
        while (cur != NULL) {
            cout << cur->data << "  ";
            cur = cur->next;
        }
        cout << endl;
    }

    //析构自动释放
    ~doub_Link () {
        clear ();
    };
};

//网络连接结构体
struct NetNode {
    int pid;         // 进程ID
    unsigned int ip; // IP（无符号整型存储）
    int port;        // 端口

    friend ostream& operator<<(ostream& os , const NetNode& n) {
        os << "PID :" << n.pid << " IP :" << n.ip << " Port :" << n.port;
        return os;
    }
};

int main () {
    cout << "===== 1. 模板链表基础操作 =====" << endl;
    doub_Link<int> dl;
    dl.link_push_up (10);
    dl.link_push_up (20);
    dl.link_push_up (30);
    dl.link_push_up (40);
    dl.print ();

    auto pos = dl.destination (1);
    dl.link_insert_down (99 , pos);
    cout << "插入后:" ;
    dl.print ();
    dl.link_delete (pos);
    cout << "删除后:" ;
    dl.print ();
    dl.clear ();

    cout << "\n===== 2. 网络安全节点链表模拟 =====" << endl;
    doub_Link<NetNode> secList ;
    secList.link_push_up ({ 1001 , 0xC0A80101 , 80 });
    secList.link_push_up ({ 1002 , 0xC0A80102 , 443 });
    secList.link_push_up ({ 1003 , 0xC0A80103 , 3389 });
    secList.print ();

    //模拟：定位高危3389恶意连接，执行隔离删除
    auto malware = secList.destination (2);
    if (malware) {
        cout << "检测到恶意连接:" ;
        cout << malware->data << endl;
        secList.link_delete (malware);
        cout << "已隔离该连接:";
        secList.print ();
    }

    cout << "\n===== 3. 内存安全测试 =====" << endl;
    doub_Link<int> test;
    for (int i = 0; i < 5; ++i) test.link_push_up (i);
    test.print ();
    test.clear ();
    cout << "清空后size = " << test.size << endl;
    return 0;
}
```

